# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.

# Postgres connection. On Supabase use the *transaction pooler* URL (port 6543), e.g.
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:dev@localhost:54329/outreach

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this site, no trailing slash. The OAuth redirect URI is ${APP_URL}/api/auth/callback.
# POST requests must come from this host (CSRF check).
APP_URL=http://localhost:3000

# Signs the session cookie. At least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=

# Encrypts Gmail refresh tokens (AES-256-GCM). Base64 of exactly 32 random bytes.
# MUST be the same value the Python worker uses. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Who may sign in. Comma-separated, case-insensitive.
ALLOWED_EMAILS=sender@g.ucla.edu,tester@g.ucla.edu

# The Google account the worker sends from (its token must be stored and 'ok' before Send works).
SENDER_EMAIL=sender@g.ucla.edu

# Most emails per day (Los Angeles time), across all runs. Default 1000.
DAILY_LIMIT=1000

# Optional: pre-selects this Google Workspace domain on Google's account picker (a hint, not a check).
GOOGLE_HOSTED_DOMAIN=g.ucla.edu

# Local testing only: enables GET /api/auth/dev-login?email=... (never works when NODE_ENV=production).
# DEV_LOGIN=1
