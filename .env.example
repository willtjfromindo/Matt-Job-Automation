# Copy to .env (laptop scripts) and paste the same values into Railway (sender).

# Supabase > Project Settings > Database > Connection string (use the "Session pooler" URI)
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# AI that writes the one personal sentence. Put your OpenAI key here.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Or use Claude instead: AI_PROVIDER=anthropic and set ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# Google Cloud > APIs & Services > Credentials (same values as the website)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as the website. Make one with: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# Who the emails are sent from. Use your own address while testing; the real sender at the end.
SENDER_EMAIL=you@example.com
SENDER_NAME=Your Name
# How the templates introduce and sign off for you (see templates/README.txt).
SENDER_SCHOOL=Your University
SENDER_TAGLINE=Your University Economics | Class of 2027
SENDER_INTRO=I'm a Your University Economics senior graduating in June 2027, and I recently interned at Example Consulting.

# Practice mode: every email goes to PRACTICE_INBOX instead of the real person.
# Stays on until this says false.
PRACTICE_MODE=true
PRACTICE_INBOX=you@example.com

# Sending rules
DAILY_LIMIT=1000
MIN_GAP_SECONDS=20
MAX_GAP_SECONDS=34
FOLLOWUP1_BUSINESS_DAYS=5
FOLLOWUP2_BUSINESS_DAYS=7
# Stop a run if more than 5% of its people can't be reached at any guessed address
# (after at least 40 sends)
BOUNCE_STOP_RATE=0.05
BOUNCE_STOP_MIN_SENDS=40
# Guessed emails: a guess counts as working after this many minutes with no bounce; a bounce
# sends the same email to the person's next likely address. Pause for the day after this many
# bounces, to protect the sending account.
BOUNCE_WAIT_MINUTES=15
MAX_BOUNCES_PER_DAY=10

# Optional paid email checker (recommended at this volume)
NEVERBOUNCE_API_KEY=

# Attached to every first email (the templates say "I've attached my resume")
RESUME_PATH=data/resume/Your_Name_Resume.pdf
